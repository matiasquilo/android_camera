<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 1. Solicitas el permiso para usar la cámara -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- 2. Declaras que la cámara es necesaria, pero puede ser CUALQUIERA (frontal, trasera o externa) -->
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- 3. Indicas explícitamente que la cámara TRASERA NO es obligatoria (para soportar Chromebooks/laptops) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 4. Indicas que el enfoque automático NO es obligatorio -->
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- 5. El flash no es obligatorio, pero lo declaramos para poder usarlo si existe -->
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VintageCameraApp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VintageCameraApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>